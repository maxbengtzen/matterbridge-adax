{
  "name": "matterbridge-adax",
  "version": "0.4.0",
  "description": "Matterbridge plugin for Adax WiFi heaters",
  "author": "@maxbengtzen",
  "license": "MIT",
  "type": "module",
  "main": "dist/module.js",
  "exports": {
    ".": {
      "import": "./dist/module.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbengtzen/matterbridge-adax.git"
  },
  "homepage": "https://github.com/maxbengtzen/matterbridge-adax#readme",
  "bugs": {
    "url": "https://github.com/maxbengtzen/matterbridge-adax/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "keywords": [
    "matterbridge",
    "matter",
    "adax",
    "heater",
    "thermostat"
  ],
  "scripts": {
    "setup": "npm install --no-save --no-fund --no-audit matterbridge@3.10.13",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "preversion": "npm run check",
    "version": "npm run build && git add dist"
  },
  "files": [
    "dist",
    "matterbridge-adax.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
